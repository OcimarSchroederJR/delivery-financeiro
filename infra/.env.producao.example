# Variáveis de PRODUÇÃO (VM). Modelo sem valores: nenhum segredo real entra no repositório.
# Na VM, o pipeline de deploy grava o .env a partir dos GitHub Secrets (docs/deploy.md).
# O compose.prod.yaml usa ${VAR:?}: variável vazia ou ausente impede o compose de subir.
#
# Gerar segredos (>= 32 caracteres, só letras, números, - e _):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# As senhas entram em URLs (amqp://, postgresql://); token_urlsafe já gera nesse formato.

# --- Imagens e domínio -----------------------------------------------------------------

# Tag das imagens ghcr.io/ocimarschroederjr/<servico>. Preenchida pelo pipeline com o SHA do commit.
TAG=
# Domínio público servido pelo Caddy, por exemplo financeiro-eq5.<ip-da-vm>.sslip.io
DOMINIO=

# --- Basic auth de /jaeger e /mailpit ----------------------------------------------------

BASIC_AUTH_USUARIO=
# Hash bcrypt da senha, entre aspas SIMPLES (o compose interpola "$" sem elas):
#   docker run --rm caddy:2.10.2-alpine caddy hash-password --plaintext '<senha>'
BASIC_AUTH_HASH=

# --- Segredos da aplicação ---------------------------------------------------------------

# Segredo HS256 do token de serviço interno, igual nos 3 serviços. >= 32 caracteres.
# O valor padrão de desenvolvimento é recusado no boot com AMBIENTE=producao.
TOKEN_SERVICO_SEGREDO=
# Notificações: chave que cifra os segredos dos webhooks em repouso. >= 32 caracteres.
# Use um valor diferente do TOKEN_SERVICO_SEGREDO. Trocá-la invalida os webhooks já cadastrados.
WEBHOOK_SEGREDO_CIFRAGEM=

# --- Infraestrutura interna --------------------------------------------------------------

RABBITMQ_USUARIO=
RABBITMQ_SENHA=
# Senhas dos bancos, uma por serviço. Usadas na primeira subida do Postgres:
# trocar depois exige alterar a senha também dentro do banco.
PAGAMENTOS_DB_SENHA=
NOTIFICACOES_DB_SENHA=
AVALIACOES_DB_SENHA=

# --- Outras equipes ----------------------------------------------------------------------
# Obrigatórias em produção: sem elas os serviços recusam o boot.
# Enquanto uma equipe não estiver no ar, aponte para o mock e suba com --profile mocks
# (ex.: JWKS_URL=http://mock-identidade:8001/.well-known/jwks.json).

# Equipe 1 (Identidade): JWKS para validar os JWT e API de perfis (Notificações)
JWKS_URL=
IDENTIDADE_URL=
# Equipe 3 (Checkout/Pedidos): usada por Pagamentos e Avaliações
PEDIDOS_URL=

# --- Opcionais (têm padrão) --------------------------------------------------------------

# E-mail que recebe os avisos ao admin (ex.: disputa.estorno_falhou)
EMAIL_ADMIN=
# DEBUG, INFO, WARNING ou ERROR (padrão INFO)
LOG_NIVEL=
# Envia traces ao Jaeger interno (padrão true)
OTEL_HABILITADO=
# Credencial de serviço da Equipe 1 para GET /perfis/{id} (Bearer). Só quando a Eq. 1 fornecer.
IDENTIDADE_CREDENCIAL=
