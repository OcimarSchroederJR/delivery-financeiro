# Variáveis para subir o compose de PRODUÇÃO na sua máquina (DOMINIO=localhost).
#   cp infra/.env.local.example infra/.env
# Os valores abaixo são fictícios e públicos: NUNCA use-os na VM.
# Senhas entram em URLs (amqp://, postgresql://): use só letras, números, - e _.

# Domínio servido pelo Caddy. localhost usa a CA interna do Caddy (curl -k).
DOMINIO=localhost

# Basic auth de /jaeger e /mailpit. Gere o hash com:
#   docker run --rm caddy:2.10.2-alpine caddy hash-password --plaintext '<senha>'
# Aspas SIMPLES no hash: sem elas o compose tenta interpolar os "$" do bcrypt.
# Senha deste exemplo: senha-local-paineis
BASIC_AUTH_USUARIO=admin
BASIC_AUTH_HASH='$2a$14$0bSM9h8TaLEvtcet/iZspekoTyXgk.zgkXq9r7IFmP99NvBpFhnmO'

# Tag das imagens ghcr.io/ocimarschroederjr/<servico>. Na VM, o pipeline usa o SHA do commit.
TAG=local

# Segredo do token de serviço interno (HS256). >= 32 caracteres.
TOKEN_SERVICO_SEGREDO=segredo-local-producao-financeiro-eq5-nao-use-na-vm

# JWKS da Equipe 1. Aqui aponta para o mock (suba com --profile mocks).
JWKS_URL=http://mock-identidade:8001/.well-known/jwks.json

# URLs das outras equipes. Aqui apontam para os mocks (suba com --profile mocks).
PEDIDOS_URL=http://mock-pedidos:8008
IDENTIDADE_URL=http://mock-identidade:8001

# RabbitMQ
RABBITMQ_USUARIO=financeiro
RABBITMQ_SENHA=senha-local-rabbitmq

# Senhas dos bancos (uma por serviço)
PAGAMENTOS_DB_SENHA=senha-local-pagamentos
NOTIFICACOES_DB_SENHA=senha-local-notificacoes
AVALIACOES_DB_SENHA=senha-local-avaliacoes

# Notificações: chave que cifra o segredo dos webhooks em repouso (>= 32 caracteres).
WEBHOOK_SEGREDO_CIFRAGEM=chave-local-cifragem-webhooks-financeiro-eq5
