# Copie para .env (ignorado pelo git) e ajuste o que quiser sobrescrever.
# Todos os valores abaixo já são o padrão do compose.

# Formato dos logs: console (colorido, demo) ou json (produção)
LOG_FORMATO=console
# Envia traces para o Jaeger (http://localhost:16686)
OTEL_HABILITADO=true

# Segredo do token de serviço interno (HS256, iss=financeiro-eq5). >= 32 caracteres.
TOKEN_SERVICO_SEGREDO=segredo-local-financeiro-eq5-troque-em-producao

# URLs das outras equipes. Padrão: mocks do profile "mocks".
JWKS_URL=http://mock-identidade:8001/.well-known/jwks.json
IDENTIDADE_URL=http://mock-identidade:8001
PEDIDOS_URL=http://mock-pedidos:8008
PAGAMENTOS_URL=http://pagamentos:8000

# Papel do token que o mock de logística usa ao chamar POST /v1/eventos
MOCK_LOGISTICA_PAPEL=entregador

# Notificações: e-mail que recebe os avisos ao admin (ex.: disputa.estorno_falhou)
EMAIL_ADMIN=admin@financeiro-eq5.local
# Notificações: chave para cifrar o segredo dos webhooks em repouso (>= 32 caracteres).
# Obrigatória em produção; fora dela, sem valor, a chave deriva de TOKEN_SERVICO_SEGREDO.
# WEBHOOK_SEGREDO_CIFRAGEM=
# Notificações: credencial de serviço da Eq. 1 para GET /perfis/{id} (opcional; Bearer)
# IDENTIDADE_CREDENCIAL=
