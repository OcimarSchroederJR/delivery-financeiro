{
  "components": {
    "schemas": {
      "CartaoEntrada": {
        "additionalProperties": false,
        "description": "Nunca persistido nem logado; só os 4 últimos dígitos são guardados.",
        "properties": {
          "cvv": {
            "examples": [
              "123"
            ],
            "pattern": "^[0-9]{3,4}$",
            "title": "Cvv",
            "type": "string"
          },
          "numero": {
            "examples": [
              "4111111111110000"
            ],
            "pattern": "^[0-9]{13,19}$",
            "title": "Numero",
            "type": "string"
          },
          "titular": {
            "maxLength": 100,
            "minLength": 1,
            "title": "Titular",
            "type": "string"
          },
          "validade": {
            "examples": [
              "12/28"
            ],
            "pattern": "^(0[1-9]|1[0-2])/[0-9]{2}$",
            "title": "Validade",
            "type": "string"
          }
        },
        "required": [
          "numero",
          "titular",
          "validade",
          "cvv"
        ],
        "title": "CartaoEntrada",
        "type": "object"
      },
      "CorpoErro": {
        "additionalProperties": true,
        "description": "Schema do corpo de erro (documentação OpenAPI).",
        "properties": {
          "codigo": {
            "title": "Codigo",
            "type": "string"
          },
          "correlation_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Correlation Id"
          },
          "erro": {
            "default": true,
            "title": "Erro",
            "type": "boolean"
          },
          "mensagem": {
            "title": "Mensagem",
            "type": "string"
          }
        },
        "required": [
          "mensagem",
          "codigo"
        ],
        "title": "CorpoErro",
        "type": "object"
      },
      "CriarPagamentoEntrada": {
        "additionalProperties": false,
        "description": "Não há campo de valor: ele vem da Eq. 3 (regra 1).",
        "properties": {
          "cartao": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/CartaoEntrada"
              },
              {
                "type": "null"
              }
            ]
          },
          "metodo": {
            "$ref": "#/components/schemas/MetodoPagamento"
          },
          "pedido_id": {
            "examples": [
              "ped-1"
            ],
            "pattern": "^[A-Za-z0-9_-]{1,64}$",
            "title": "Pedido Id",
            "type": "string"
          }
        },
        "required": [
          "pedido_id",
          "metodo"
        ],
        "title": "CriarPagamentoEntrada",
        "type": "object"
      },
      "EstornarEntrada": {
        "additionalProperties": false,
        "description": "Sem ``valor_centavos``, estorna o saldo estornável inteiro.",
        "properties": {
          "motivo": {
            "examples": [
              "disputa procedente"
            ],
            "maxLength": 500,
            "minLength": 1,
            "title": "Motivo",
            "type": "string"
          },
          "valor_centavos": {
            "anyOf": [
              {
                "exclusiveMinimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "examples": [
              1000
            ],
            "title": "Valor Centavos"
          }
        },
        "required": [
          "motivo"
        ],
        "title": "EstornarEntrada",
        "type": "object"
      },
      "EstornoCriadoSaida": {
        "description": "Corpo do 201 do estorno. ``status`` é o status do pagamento após este estorno.",
