        "parameters": [
          {
            "description": "Obrigatório. Chave única da operação (1 a 255 caracteres ASCII visíveis), válida por 24 h.",
            "in": "header",
            "name": "Idempotency-Key",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
