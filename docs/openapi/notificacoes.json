  "info": {
    "description": "Serviço de Notificações da Equipe 5 (Financeiro e Pós): recebe eventos de outras equipes em POST /v1/eventos, envia e-mails por template e entrega webhooks assinados com HMAC-SHA256 (retry 1 s, 5 s, 30 s, 2 min e 10 min; depois, DLQ).",
    "title": "Notificações",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
