    "/v1/eventos": {
      "post": {
        "description": "Valida o envelope, deduplica por mensagem_id e o publica em financeiro.eventos (routing key = tipo). Papéis: loja, entregador, admin.",
        "operationId": "receber_evento_v1_eventos_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "description": "``tipo`` = ``entidade.fato_no_passado`` e é também a routing key.",
                "properties": {
                  "correlation_id": {
                    "maxLength": 128,
                    "minLength": 1,
                    "title": "Correlation Id",
                    "type": "string"
                  },
                  "dados": {
                    "additionalProperties": true,
                    "title": "Dados",
                    "type": "object"
                  },
                  "mensagem_id": {
                    "format": "uuid",
                    "title": "Mensagem Id",
                    "type": "string"
                  },
                  "ocorrido_em": {
                    "format": "date-time",
                    "title": "Ocorrido Em",
                    "type": "string"
                  },
                  "tipo": {
                    "maxLength": 100,
                    "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$",
                    "title": "Tipo",
                    "type": "string"
                  },
                  "versao": {
                    "default": 1,
                    "minimum": 1.0,
                    "title": "Versao",
                    "type": "integer"
                  }
                },
                "required": [
                  "mensagem_id",
                  "tipo",
                  "ocorrido_em",
                  "correlation_id"
                ],
                "title": "EnvelopeEvento",
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventoAceito"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CorpoErro"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CorpoErro"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CorpoErro"
                }
              }
            },
            "description": "Forbidden"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Recebe um evento de outra equipe (ex.: pedido.*, entrega.*)",
        "tags": [
          "eventos"
        ]
      }
    },
