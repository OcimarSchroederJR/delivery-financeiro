{
  "info": {
    "name": "Delivery Financeiro - Equipe 5",
    "description": "Fluxo completo da demo: login, pedido, pagamento, e-mail, entrega, avaliação, disputa com estorno e resiliência.\n\nSuba a stack com `docker compose --profile mocks up -d --build` e rode com o ambiente `local`. Tudo manda o mesmo `X-Correlation-ID` para o fluxo aparecer amarrado nos logs e no Jaeger.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token_cliente}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Mesmo correlation_id em todas as requests da execução",
          "const correlationId = pm.collectionVariables.get('correlation_id');",
          "if (correlationId) {",
          "    pm.request.headers.upsert({ key: 'X-Correlation-ID', value: correlationId });",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "restaurante_id",
      "value": "rest-1"
    },
    {
      "key": "execucao",
      "value": ""
    },
    {
      "key": "correlation_id",
      "value": ""
    },
    {
      "key": "token_cliente",
      "value": ""
    },
