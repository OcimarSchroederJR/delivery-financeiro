  "item": [
    {
      "name": "1. Autenticação",
      "description": "Tokens do mock da Eq. 1, um por papel. Ficam em variáveis da coleção.",
      "item": [
        {
          "name": "Token do cliente",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{identidade}}/tokens",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sub\": \"cliente-1\",\n  \"papel\": \"cliente\",\n  \"email\": \"cliente-1@exemplo.com\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Cada execução usa pedidos novos e um correlation_id próprio",
                  "const execucao = Date.now().toString(36);",
                  "pm.collectionVariables.set('execucao', execucao);",
                  "pm.collectionVariables.set('correlation_id', 'demo-' + execucao);",
                  "['cartao', 'recusado', 'caro', 'pix', 'resiliencia'].forEach((tipo) =>",
                  "    pm.collectionVariables.set('pedido_' + tipo, `ped-${execucao}-${tipo}`));",
                  "pm.request.headers.upsert({",
                  "    key: 'X-Correlation-ID', value: pm.collectionVariables.get('correlation_id') });"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('token_cliente', pm.response.json().access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Token do admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{identidade}}/tokens",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sub\": \"admin-1\",\n  \"papel\": \"admin\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
