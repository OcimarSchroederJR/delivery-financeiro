    {
      "name": "7. Disputa",
      "description": "O cliente contesta, o admin aprova e a saga estorna em Pagamentos.",
      "item": [
        {
          "name": "Abrir disputa",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{avaliacoes}}/v1/disputas",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pedido_id\": \"{{pedido_cartao}}\",\n  \"motivo\": \"item_faltando\",\n  \"descricao\": \"Faltou o refrigerante.\",\n  \"valor_solicitado_centavos\": 1000\n}"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token_cliente}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "pm.test('disputa aberta', () => pm.expect(pm.response.json().status).to.eql('aberta'));",
                  "pm.collectionVariables.set('disputa_id', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Admin julga procedente",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{avaliacoes}}/v1/disputas/{{disputa_id}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"procedente\",\n  \"parecer\": \"Item confirmado pela loja.\"\n}"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token_admin}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('estorno feito e disputa resolvida', () => {",
                  "    pm.expect(pm.response.json().status).to.eql('resolvida');",
                  "    pm.expect(pm.response.json().estorno_id).to.be.a('string');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Estorno aparece em Pagamentos",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{pagamentos}}/v1/pagamentos/{{pagamento_id}}/estornos",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token_cliente}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('estorno de R$ 10,00', () => {",
                  "    const itens = pm.response.json().itens;",
                  "    pm.expect(itens.map((e) => e.valor_centavos)).to.include(1000);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "E-mail de disputa resolvida",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{mailpit}}/api/v1/search?query=subject:\"Disputa procedente - pedido {{pedido_cartao}}\"",
            "auth": {
              "type": "noauth"
            },
            "description": "Repete por até 30 s até o e-mail chegar no Mailpit."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const tentativa = Number(pm.collectionVariables.get('tentativa_email') || 0);",
                  "const chegou = pm.response.code === 200 && pm.response.json().messages_count > 0;",
                  "if (!chegou && tentativa < 30) {",
                  "    // O worker ainda não mandou; tenta de novo em 1 s",
                  "    pm.collectionVariables.set('tentativa_email', tentativa + 1);",
                  "    setTimeout(() => {}, 1000);",
                  "    postman.setNextRequest(pm.info.requestName);",
                  "} else {",
                  "    pm.collectionVariables.unset('tentativa_email');",
                  "    pm.test('e-mail chegou no Mailpit', () => pm.expect(chegou).to.eql(true));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Entregas do webhook",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{notificacoes}}/v1/webhooks/{{assinatura_id}}/entregas",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token_cliente}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('tentativas registradas', () =>",
                  "    pm.expect(pm.response.json().itens).to.be.an('array'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "8. Resiliência",
      "description": "Eq. 3 fora do ar vira 503 amigável; erros sempre no formato padrão.",
      "item": [
        {
          "name": "Derrubar o mock de pedidos",
          "request": {
            "method": "PUT",
            "header": [
