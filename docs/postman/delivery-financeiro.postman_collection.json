            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "const assinatura = pm.response.json();",
                  "pm.test('segredo só aparece na criação', () =>",
