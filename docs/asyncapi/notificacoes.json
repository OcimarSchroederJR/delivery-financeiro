    "schemas": {
      "DadosTarefa": {
        "properties": {
          "evento": {
            "$ref": "#/components/schemas/EnvelopeEvento"
          },
          "notificacao_id": {
            "format": "uuid",
            "title": "Notificacao Id",
            "type": "string"
          }
        },
        "required": [
          "notificacao_id",
          "evento"
        ],
        "title": "DadosTarefa",
        "type": "object"
      },
      "EnvelopeEvento": {
        "description": "``tipo`` = ``entidade.fato_no_passado`` e é também a routing key.",
        "properties": {
          "correlation_id": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Correlation Id",
            "type": "string"
          },
          "dados": {
            "additionalProperties": true,
            "title": "Dados",
            "type": "object"
          },
          "mensagem_id": {
            "format": "uuid",
            "title": "Mensagem Id",
            "type": "string"
          },
          "ocorrido_em": {
            "format": "date-time",
            "title": "Ocorrido Em",
            "type": "string"
          },
          "tipo": {
            "maxLength": 100,
            "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$",
            "title": "Tipo",
            "type": "string"
          },
          "versao": {
            "default": 1,
            "minimum": 1,
            "title": "Versao",
            "type": "integer"
          }
        },
        "required": [
          "mensagem_id",
          "tipo",
          "ocorrido_em",
          "correlation_id"
        ],
        "title": "EnvelopeEvento",
        "type": "object"
      },
      "EnvelopeTarefa": {
        "description": "Envelope interno de tarefa (``tarefa.email`` ou ``tarefa.webhook``).",
        "properties": {
          "correlation_id": {
            "title": "Correlation Id",
            "type": "string"
          },
          "dados": {
            "$ref": "#/components/schemas/DadosTarefa"
          },
          "mensagem_id": {
            "format": "uuid",
            "title": "Mensagem Id",
            "type": "string"
          },
          "ocorrido_em": {
            "format": "date-time",
            "title": "Ocorrido Em",
            "type": "string"
          },
          "tipo": {
            "enum": [
              "tarefa.email",
              "tarefa.webhook"
            ],
            "title": "Tipo",
            "type": "string"
          },
          "versao": {
            "default": 1,
            "title": "Versao",
            "type": "integer"
          }
        },
        "required": [
          "mensagem_id",
          "tipo",
          "ocorrido_em",
          "correlation_id",
          "dados"
        ],
        "title": "EnvelopeTarefa",
        "type": "object"
      }
    }
